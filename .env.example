# Copy to .env. No keys or database needed for local personal mode.
SITE_URL=http://127.0.0.1:3000
NEXT_TELEMETRY_DISABLED=1
# Local mode writes atomic, owner-scoped files here (single Node process only).
DATA_DIR=.data
# Optional PostgreSQL; use this for multiple server processes.
# DATABASE_URL=postgresql://still:change-me@127.0.0.1:5432/still?schema=public
# Set a random 64+ character server secret for deployment; never expose to client.
# SESSION_SECRET=
# Optional agent bearer credential. Agents use a separate principal from browsers.
# AWP_TOKEN=
# Optional Ollama. Configure a model you have installed; never auto-falls back to cloud.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=
# Optional Cloudflare Access service token (server-only; both required with HTTPS).
# OLLAMA_ACCESS_CLIENT_ID=
# OLLAMA_ACCESS_CLIENT_SECRET=
# Simplest optional cloud: one server-only Groq key. Then opt in in Settings.
# Uses openai/gpt-oss-120b directly; no CLOUD_MODEL needed. See docs/GROQ.md.
# GROQ_API_KEY=
# Alternative cloud via AI Gateway (used only when GROQ_API_KEY is absent).
# Choose a current model from its model catalog.
# AI_GATEWAY_API_KEY=
# CLOUD_MODEL=provider/model-id

# Optional API.Bible Starter access: server-only key and authorized edition IDs.
# API_BIBLE_KEY=
# API_BIBLE_CSB_ID=
# API_BIBLE_NLT_ID=
# API_BIBLE_MSG_ID=
# Optional server default when translation is omitted (CSB, NLT, MSG, or WEB).
# DEFAULT_TRANSLATION=CSB
# Confirm non-commercial eligibility before enabling.
API_BIBLE_NONCOMMERCIAL=false
