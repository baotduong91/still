{
  "name": "bible-devotional-awp",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --webpack --hostname 127.0.0.1",
    "build": "prisma generate && NEXT_TELEMETRY_DISABLED=1 next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:sanity": "playwright test journey-sanity.spec.ts awp-sanity.spec.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "node --import tsx prisma/seed.ts",
    "samples": "node --import tsx scripts/samples.ts",
    "bible:import": "node --import tsx scripts/import-bible.ts",
    "db:migrate": "prisma migrate deploy",
    "format": "prettier --write app components lib prisma scripts tests *.ts *.json *.mjs",
    "prebuild": "node scripts/prepare-tts.mjs",
    "predev": "node scripts/prepare-tts.mjs"
  },
  "dependencies": {
    "@ai-sdk/groq": "^4.0.78",
    "@huggingface/transformers": "3.8.1",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-slot": "^1.2.0",
    "ai": "7.0.166",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "idb": "^8.0.3",
    "kokoro-js": "1.2.1",
    "lucide-react": "^0.468.0",
    "next": "16.4.6",
    "node-edge-tts": "1.2.12",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "ajv": "^8.17.1",
    "prettier": "^3.9.10",
    "prisma": "6.19.3",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "5.1.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "@huggingface/transformers": {
      "sharp": "^0.35.0"
    }
  },
  "type": "module"
}
